FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

# Install python and uv
RUN apt-get update && apt-get install -y python3 python3-pip && \
    pip3 install uv

WORKDIR /app

# Install vLLM with gpt-oss support as per requirements
RUN uv pip install --system --pre vllm==0.10.1+gptoss \
    --extra-index-url https://wheels.vllm.ai/gpt-oss/ \
    --extra-index-url https://download.pytorch.org/whl/nightly/cu128 \
    --index-strategy unsafe-best-match

# Set environment variables for Grace Blackwell optimization if necessary
# vLLM usually handles GB10 well automatically
ENV CUDA_VISIBLE_DEVICES=0

# Command to serve the model with optimizations for Grace Blackwell
# --gpu-memory-utilization 0.90: Safe buffer for stability
# --max-num-seqs 256: Standard batch size for good performance
ENTRYPOINT ["vllm", "serve", "openai/gpt-oss-20b"]
CMD ["--host", "0.0.0.0", "--port", "8000", "--gpu-memory-utilization", "0.90", "--max-num-seqs", "256"]
